# TraceRuntime — Environment Variables
# Copy this file to .env and adjust values as needed.
# cp .env.example .env

# ─── Go API ──────────────────────────────────────────────────────────────────
GO_API_PORT=8082

# ─── AI Runtime (Python/FastAPI) ─────────────────────────────────────────────
AI_RUNTIME_PORT=8001

# ─── Observability ───────────────────────────────────────────────────────────
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
LOKI_PORT=3100

# ─── OTEL Collector ──────────────────────────────────────────────────────────
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_COLLECTOR_METRICS_PORT=8889

# ─── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_DB=traceruntime
POSTGRES_USER=traceruntime
POSTGRES_PASSWORD=changeme

# ─── LocalStack (SQS/S3) ────────────────────────────────────────────────────
LOCALSTACK_PORT=4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ─── Queue ───────────────────────────────────────────────────────────────────
QUEUE_BACKEND=sqs
SQS_QUEUE_URL=http://localhost:4566/000000000000/traceruntime-tasks
SQS_DLQ_URL=http://localhost:4566/000000000000/traceruntime-tasks-dlq

# ─── Internal Token (auto-healing, chaos) ────────────────────────────────────
INTERNAL_TOKEN=changeme
